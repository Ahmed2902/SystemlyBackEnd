{
  "name": "hgezli-backend",
  "version": "1.0.0",
  "description": "Systemly multi-tenant appointment platform API",
  "main": "dist/server.js",
  "scripts": {
    "start:prod": "node dist/server.js",
    "build": "npx tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "npx tsc -p tsconfig.json && node dist/server.js",
    "prisma:generate": "npx prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate:deploy": "npx prisma migrate deploy --schema=prisma/schema.prisma",
    "graphile:migrate": "graphile-worker --schema-only",
    "seed:plans": "node dist/src/scripts/seedPlans.js",
    "sentry:verify": "npm run build && node dist/src/scripts/verifySentry.js",
    "test": "jest --runInBand --forceExit",
    "validate:openapi": "node scripts/validate-openapi.js",
    "generate:openapi": "node scripts/generate-openapi.js",
    "studio:local": "node scripts/run-prisma-studio.js",
    "perf:benchmark": "node scripts/benchmark-endpoints.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.1.0",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "@sentry/node": "^7.47.0",
    "@supabase/supabase-js": "^2.110.2",
    "@types/jest": "^30.0.0",
    "apple-signin-auth": "^2.0.0",
    "axios": "^1.15.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.9.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "dotenv-expand": "^13.0.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "google-auth-library": "^10.6.2",
    "graphile-worker": "^0.17.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jest": "^30.4.2",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.2.9",
    "luxon": "^3.7.2",
    "multer": "^2.1.1",
    "node-fetch": "^2.6.9",
    "pdfkit": "^0.19.1",
    "pg": "^8.20.0",
    "postgres": "^3.4.9",
    "prisma": "^6.19.3",
    "prom-client": "^14.0.1",
    "resend": "^6.11.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ts-jest": "^29.4.9",
    "uuid": "^8.3.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^9.0.0",
    "@types/express": "^5.0.6",
    "@types/luxon": "^3.7.2",
    "@types/node": "^25.6.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^8.3.4",
    "typescript": "^5.3.3"
  }
}
