{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    //"moduleResolution": "Node",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "app.ts",
    "server.ts",
    "index.ts",
    "src/**/*.ts",
    "src/**/*.d.ts"
    // "business.routes.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
