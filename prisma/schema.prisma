generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")

}

enum AppointmentStatus {
  pending
  confirmed
  cancelled_by_customer
  cancelled_by_business
  no_show
  completed
}

enum Roles {
  SuperAdmin
  BusinessAdmin
  Staff
  Receptionist
  User
}

enum NotificationChannel {
  SMS
  EMAIL
  WHATSAPP
}

enum CommissionType {
  NONE
  FLAT
  PERCENT
}

enum InvoiceStatus {
  draft
  sent
  paid
  voided
}

model Business {
  id             String          @id @default(uuid()) @db.Uuid
  name           String          @db.VarChar(255)
  slug           String          @unique @db.VarChar(120)
  vertical       String         @db.VarChar(80)
  phone          String          @db.VarChar(30)
  address        String?         @db.Text
  city           String?         @db.VarChar(120)
  lat            Decimal?        @db.Decimal(10, 7)
  lng            Decimal?        @db.Decimal(10, 7)
  logoUrl        String?         @map("logo_url") @db.Text
  coverUrl       String?         @map("cover_url") @db.Text
  timezone       String          @default("Africa/Cairo") @db.VarChar(80)
  language       String          @default("ar") @db.VarChar(10)
  isActive       Boolean         @default(false) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  staffInvite    StaffInvite[]
  appointments   Appointment[]
  businessUsers  BusinessUser[]
  customers      Customer[]
  faqs           Faq[]
  services       Service[]
  staff          Staff[]
  subscription   Subscription?
  websiteContent WebsiteContent?
  websiteSetup   WebsiteSetup?
  photos         Photo[]
  invoices       Invoice[]
  loyaltyAccounts LoyaltyAccount[]

  @@index([city])
  @@map("businesses")
}

model BusinessUser {
  id            String    @id @default(uuid()) @db.Uuid
  businessId    String?   @map("business_id") @db.Uuid
  name          String    @db.VarChar(255)
  email         String    @unique @db.VarChar(255)
  passwordHash  String    @map("password_hash") @db.Text
  phone         String?   @db.VarChar(30)
  phoneVerified Boolean   @default(false) @map("phone_verified")
  emailVerified Boolean   @default(false) @map("email_verified")
  currentRefreshTokenId String? @map("current_refresh_token_id") @db.Uuid @unique
  role          Roles
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  provider      String?
  providerId    String?   @unique
  business      Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  currentRefreshToken RefreshToken? @relation("CurrentRefreshToken", fields: [currentRefreshTokenId], references: [id])
  websiteSetups  WebsiteSetup[]
  refreshTokens  RefreshToken[]

  @@index([businessId])
  @@map("business_users")
}

model Staff {
  id                    String                 @id @default(uuid()) @db.Uuid
  businessId            String                 @map("business_id") @db.Uuid
  name                  String                 @db.VarChar(255)
  role                  Roles                  @default(Staff)
  photoUrl              String?                @map("photo_url") @db.Text
  isActive              Boolean                @default(true) @map("is_active")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  appointments          Appointment[]
  availability          Availability[]
  availabilityOverrides AvailabilityOverride[]
  business              Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceStaff          ServiceStaff[]
  InvoiceLineItems        InvoiceLineItem[]

  @@index([businessId])
  @@map("staff")
}



model LoyaltyAccount {
  id            String   @id @default(uuid()) @db.Uuid
  customerId    String   @map("customer_id") @db.Uuid
  businessId    String   @map("business_id") @db.Uuid
  pointsBalance Int      @map("points_balance") @default(0)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  transactions LoyaltyTransaction[]

  @@unique([customerId, businessId])
  @@index([businessId])
  @@map("loyalty_accounts")
}

model LoyaltyTransaction {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  invoiceId String?  @map("invoice_id") @db.Uuid
  points    Int
  type      String   @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")

  account LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  invoice Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@unique([invoiceId, type])
  @@map("loyalty_transactions")
}

model StaffInvite {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  email      String   @db.VarChar(255)
  role       Roles
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  createdAt  DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("staff_invites")
}

model Service {
  id           String         @id @default(uuid()) @db.Uuid
  businessId   String         @map("business_id") @db.Uuid
  name         String         @db.VarChar(255)
  durationMin  Int            @map("duration_min")
  priceEgp     Decimal        @map("price_egp") @db.Decimal(10, 2)
  description  String?        @db.Text
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  category     String?        @db.VarChar(80) @map("category")

  appointments Appointment[]
  business     Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceStaff ServiceStaff[]
  invoiceLineItems InvoiceLineItem[]

  @@index([businessId, category])
  @@index([businessId])
  @@map("services")
}

model ServiceStaff {
  serviceId String  @map("service_id") @db.Uuid
  staffId   String  @map("staff_id") @db.Uuid
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  commissionType     CommissionType @default(NONE) @map("commission_type")
  commissionAmount   Int            @default(0) @map("commission_amount")

  @@id([serviceId, staffId])
  @@index([staffId])
  @@map("service_staff")
}

model Availability {
  id            String   @id @default(uuid()) @db.Uuid
  staffId       String   @map("staff_id") @db.Uuid
  dayOfWeek     Int      @map("day_of_week")
  startTime     DateTime @map("start_time")
  endTime       DateTime @map("end_time")
  breakAfterMin Int?     @map("break_after_min")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  staff         Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, dayOfWeek, startTime, endTime])
  @@index([staffId])
  @@map("availability")
}

model AvailabilityOverride {
  id           String   @id @default(uuid()) @db.Uuid
  staffId      String   @map("staff_id") @db.Uuid
  overrideDate DateTime @map("override_date") @db.Date
  isDayOff     Boolean  @default(false) @map("is_day_off")
  startTime    DateTime? @map("start_time")
  endTime      DateTime? @map("end_time")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  staff        Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, overrideDate])
  @@map("availability_overrides")
}

model Customer {
  id           String        @id @default(uuid()) @db.Uuid
  businessId   String        @map("business_id") @db.Uuid
  name         String        @db.VarChar(255)
  phone        String        @db.VarChar(30)
  email        String?       @db.VarChar(255)
  visitCount   Int           @default(0) @map("visit_count")
  noShowCount  Int           @default(0) @map("no_show_count")
  notes        String?       @db.Text
  lastVisitAt  DateTime?     @map("last_visit_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  acquisitionSource String? @map("acquisition_source")

  appointments Appointment[]
  invoices     Invoice[]
  loyaltyAccounts LoyaltyAccount[]
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  

  @@unique([businessId, phone])
  @@unique([businessId, email])
  @@index([businessId, acquisitionSource])
  @@index([businessId])
  @@map("customers")
}

model Appointment {
  id           String            @id @default(uuid()) @db.Uuid
  businessId   String            @map("business_id") @db.Uuid
  staffId      String            @map("staff_id") @db.Uuid
  serviceId    String            @map("service_id") @db.Uuid
  customerId   String            @map("customer_id") @db.Uuid
  startsAt     DateTime          @map("starts_at")
  endsAt       DateTime          @map("ends_at")
  status       AppointmentStatus @default(pending)
  reminderSent Boolean           @default(false) @map("reminder_sent")
  confirmationSent Boolean       @default(false) @map("confirmation_sent")
  cancelToken  String            @unique @default(uuid()) @map("cancel_token") @db.Uuid
  notes        String?           @db.Text
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime?          @updatedAt @map("updated_at")

  business     Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer     Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  service      Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  notificationLogs NotificationLog[]
  staff        Staff             @relation(fields: [staffId], references: [id], onDelete: Restrict)
  invoice      Invoice?
  appointmentPhotos AppointmentPhoto[]
  clinicVisitRecord ClinicVisitRecord?
  @@index([businessId, startsAt])
  @@index([staffId, startsAt])
  @@index([customerId])
  @@map("appointments")
}

model WebsiteContent {
  id              String   @id @default(uuid()) @db.Uuid
  businessId      String   @unique @map("business_id") @db.Uuid
  tagline         String?  @db.Text
  aboutText       String?  @map("about_text") @db.Text
  template        String?  @db.VarChar(80)
  primaryColor    String?  @map("primary_color") @db.VarChar(30)
  secondaryColor  String?  @map("secondary_color") @db.VarChar(30)
  font            String?  @db.VarChar(80)
  customDomain    String?  @map("custom_domain") @db.VarChar(255)
  sectionOrder    Json?    @map("section_order")
  showTeam        Boolean  @default(true) @map("show_team")
  showFaq         Boolean  @default(true) @map("show_faq")
  showReviews     Boolean  @default(false) @map("show_reviews")
  metaTitle       String?  @map("meta_title") @db.VarChar(255)
  metaDescription String?  @map("meta_description") @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("website_content")
}

model WebsiteSetup {
  id            String       @id @default(uuid()) @db.Uuid
  businessId    String       @unique @map("business_id") @db.Uuid
  ownerUserId   String       @map("owner_user_id") @db.Uuid
  version       Int          @default(0)
  step          Int          @default(1)
  templateId    String       @default("modern") @map("template_id") @db.VarChar(80)
  publishedAt   DateTime?    @map("published_at")
  draftEnvelope Json         @map("draft_envelope")
  siteDraft     Json         @map("site_draft")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  business      Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  ownerUser     BusinessUser @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId])
  @@map("website_setup")
}

model Faq {
  id           String   @id @default(uuid()) @db.Uuid
  businessId   String   @map("business_id") @db.Uuid
  question     String   @db.Text
  answer       String   @db.Text
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, displayOrder])
  @@map("faqs")
}

model Plan {
  id                  String         @id @default(uuid()) @db.Uuid
  name                String         @unique @db.VarChar(80)
  priceEgp            Decimal        @map("price_egp") @db.Decimal(10, 2)
  maxStaff            Int?           @map("max_staff")
  maxBookingsPerMonth Int?           @map("max_bookings_per_month")
  smsReminders        Boolean        @default(false) @map("sms_reminders")
  customDomain        Boolean        @default(false) @map("custom_domain")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")
  subscriptions       Subscription[]

  @@map("plans")
}

model Subscription {
  id                   String   @id @default(uuid()) @db.Uuid
  businessId           String?   @unique @map("business_id") @db.Uuid
  planId               String   @map("plan_id") @db.Uuid
  status               String   @db.VarChar(50)
  currentPeriodStart   DateTime @map("current_period_start")
  currentPeriodEnd     DateTime @map("current_period_end")
  paymobSubscriptionId String?  @map("paymob_subscription_id") @db.VarChar(255)
  trialNotified3Days   Boolean  @default(false) @map("trial_notified_3days")
  trialNotified1Day    Boolean  @default(false) @map("trial_notified_1day")
  expiredHandled       Boolean  @default(false) @map("expired_handled")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  business             Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan                 Plan     @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([planId])
  @@map("subscriptions")
}


model Invoice {
  id              String        @id @default(uuid()) @db.Uuid
  businessId      String        @map("business_id") @db.Uuid
  appointmentId   String?       @map("appointment_id") @db.Uuid
  customerId      String        @map("customer_id") @db.Uuid
  invoiceNumber   String        @db.VarChar(80)
  status          InvoiceStatus @default(draft)
  subtotalCents   Int           @map("subtotal_cents")
  taxCents        Int           @default(0) @map("tax_cents")
  totalCents      Int           @map("total_cents")
  currency        String        @default("EGP") @db.VarChar(10)
  notes           String?       @db.Text
  issuedAt        DateTime      @default(now()) @map("issued_at")
  paidAt          DateTime?     @map("paid_at")
  voidedAt        DateTime?     @map("voided_at")
  etaReceiptUid   String?       @map("eta_receipt_uid") @db.VarChar(255)
  etaSubmittedAt  DateTime?     @map("eta_submitted_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt

  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer        Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  appointment     Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  lineItems       InvoiceLineItem[]
  loyaltyTransactions LoyaltyTransaction[]
  insuranceClaim   InsuranceClaim?

  @@unique([businessId, invoiceNumber])
  @@unique([appointmentId])
  @@index([businessId, issuedAt])
  @@index([customerId])
  @@map("invoices")
}

model InvoiceLineItem {
  id             String   @id @default(uuid()) @db.Uuid
  invoiceId      String   @map("invoice_id") @db.Uuid
  description    String   @db.Text
  quantity       Int      @default(1)
  unitPriceCents Int      @map("unit_price_cents")
  taxCents       Int      @default(0) @map("tax_cents")
  totalCents     Int      @map("total_cents")
  serviceId      String?  @map("service_id") @db.Uuid
  staffId        String?  @map("staff_id") @db.Uuid
  // Snapshot of the commission configuration
  commissionType         CommissionType? @map("commission_type")
  commissionAmount       Int?            @map("commission_amount")

  // Final earned amount
  commissionEarnedCents  Int?            @default(0) @map("commission_earned_cents")

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  staff   Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([serviceId])
  @@index([staffId])

  @@map("invoice_line_items")
}

model NotificationLog {
  id            String             @id @default(uuid()) @db.Uuid
  appointmentId String?            @map("appointment_id") @db.Uuid
  phone         String             @db.VarChar(30)
  channel       NotificationChannel
  status        String             @db.VarChar(50)
  gatewayId     String?            @map("gateway_id") @db.VarChar(255)
  errorMessage  String?            @map("error_message") @db.Text
  sentAt        DateTime?          @map("sent_at")
  appointment   Appointment?       @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([appointmentId])
  @@index([phone, sentAt])
  @@map("notification_logs")
}

model RefreshToken {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  token      String       @unique
  revoked    Boolean      @default(false)
  expiresAt  DateTime?
  createdAt  DateTime     @default(now()) @map("created_at")
  user       BusinessUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  asCurrentFor BusinessUser? @relation("CurrentRefreshToken")

  @@map("refresh_tokens")
}

model ReminderLog {
  id            String   @id @default(uuid()) @db.Uuid
  appointmentId String   @map("appointment_id") @db.Uuid
  whenKey       String   @map("when_key") @db.VarChar(50)
  channel       String?  @db.VarChar(50)
  status        String   @default("pending") @db.VarChar(20)
  errorMessage  String?  @map("error_message") @db.Text
  sentAt        DateTime? @map("sent_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt

  @@unique([appointmentId, whenKey])
  @@index([appointmentId])
  @@map("reminder_logs")
}

model Photo {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  url        String   @db.Text
  publicId   String?  @map("public_id") @db.VarChar(255)
  kind       String   @db.VarChar(30)
  type       String?   @db.VarChar(30)
  position   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointmentPhotos AppointmentPhoto[]

  @@index([businessId, kind])
  @@index([businessId])
  @@map("photos")
}

model AppointmentPhoto {
  id            String   @id @default(uuid()) @db.Uuid
  appointmentId String   @map("appointment_id") @db.Uuid
  photoId       String   @map("photo_id") @db.Uuid
  type          String   @db.VarChar(10) // "before" | "after"
  createdAt     DateTime @default(now()) @map("created_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  photo       Photo       @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@map("appointment_photos")
}

model ClinicVisitRecord {
  id               String   @id @default(uuid()) @db.Uuid
  appointmentId    String   @unique @map("appointment_id") @db.Uuid
  notes            String?  @db.Text
  diagnosis        String?  @db.Text
  prescriptionJson Json?    @map("prescription_json")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("clinic_visit_records")
}

model InsuranceClaim {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @map("invoice_id") @db.Uuid @unique
  insurerName String   @map("insurer_name") @db.VarChar(255)
  status      String   @db.VarChar(50)
  claimRef    String?  @map("claim_ref") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("insurance_claims")
}
