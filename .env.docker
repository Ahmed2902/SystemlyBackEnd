# Local-only defaults for docker-compose. Never reuse these values in production.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hgezli
DATABASE_URL=postgresql://postgres:postgres@db:5432/hgezli?schema=public
REDIS_URL=redis://redis:6379
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001
NODE_ENV=development
JWT_SECRET=local-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=local-refresh-secret-at-least-32-characters
CSRF_SECRET=local-csrf-secret-at-least-32-characters
EMAIL_TEST_MODE=true
SUPABASE_PUBLIC_MEDIA_BUCKET=public-media
SUPABASE_PRIVATE_MEDIA_BUCKET=private-media
